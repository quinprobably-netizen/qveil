pkgname=qveil
# The version lives in core/Cargo.toml; pkgver() below reads it from there and
# makepkg keeps this line in step with it, so it never needs editing by hand.
pkgver=0.2.0
pkgrel=1
pkgdesc='Private, account-free YouTube app: no cookies, no account, optional Tor for every byte'
arch=('x86_64')
url='https://github.com/quinprobably-netizen/qveil'
license=('MIT')
# yt-dlp needs a JavaScript runtime to read YouTube, hence the hard dependency on deno.
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'mpv' 'yt-dlp' 'deno')
# The app was called veil before.
provides=('veil')
conflicts=('veil')
replaces=('veil')
optdepends=('tor: hide your IP from YouTube, with a fresh circuit per request')
makedepends=('cargo' 'gcc' 'make')
# makepkg's -flto makes ring's C objects LTO bitcode, which the Rust linker can't read.
options=('!lto' '!debug')
# This builds from the local checkout (the parent of this directory), not from a
# downloaded archive, so there is nothing to fetch and nothing to checksum.
source=()
sha256sums=()

pkgver() {
  # The package's own `version = "x.y.z"`, the first such line in the file.
  # pkgver may not contain a hyphen, which a Cargo pre-release (1.0.0-rc.1) does.
  sed -n 's/^version *= *"\(.*\)"/\1/p' "$startdir/../core/Cargo.toml" | head -n 1 | tr - _
}

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/qveil "$pkgdir/usr/bin/qveil"
  install -Dm755 build/qveil-core "$pkgdir/usr/lib/qveil/qveil-core"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 core/config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
  install -Dm644 "$startdir/qveil.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/qveil.svg"
  install -Dm644 "$startdir/qveil.desktop" "$pkgdir/usr/share/applications/qveil.desktop"
}
