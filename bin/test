#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# The package depends on the JetBrains Mono Nerd Font, so a machine without it
# fails the test of the typeface instead of skipping it. CI (which has no such
# font) skips, and QVEIL_TEST_REQUIRE_FONT=0 asks for that anywhere else.
if [ -z "${CI:-}" ]; then
    export QVEIL_TEST_REQUIRE_FONT="${QVEIL_TEST_REQUIRE_FONT:-1}"
fi

cargo test --locked --manifest-path "$ROOT/core/Cargo.toml"

# The window tests include one against the real engine, which needs the
# build tree's qveil-core; build everything first so it never silently skips.
"$ROOT/bin/build"

mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"
qmake6 "$ROOT/tests/qveil_tests.pro"
make -j"$(nproc)"
QT_QPA_PLATFORM=offscreen ./qveil_tests
